{
  "name": "ciak-studio",
  "version": "1.0.0",
  "description": "Ciak Studio — editor video non lineare open source che gira nel browser, senza installazione.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node tools/serve.js",
    "build": "node tools/build.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:e2e",
    "bench": "node tests/bench.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.50.0"
  }
}
