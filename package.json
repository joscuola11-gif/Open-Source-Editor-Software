{
  "name": "ciak-studio",
  "version": "1.0.5",
  "description": "Ciak Studio — editor video non lineare open source che gira nel browser, senza installazione.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node tools/serve.js",
    "build": "node tools/build.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:e2e",
    "bench": "node tests/bench.js",
    "desktop": "npm run build && electron .",
    "dist:win": "node tools/fetch-ffmpeg.mjs win32 x64 && npm run build && electron-builder --win",
    "dist:linux": "node tools/fetch-ffmpeg.mjs linux x64 && npm run build && electron-builder --linux",
    "dist:mac": "node tools/fetch-ffmpeg.mjs darwin arm64 && node tools/fetch-ffmpeg.mjs darwin x64 && npm run build && electron-builder --mac",
    "test:desktop": "xvfb-run -a node --test --test-concurrency=1 \"tests/desktop/*.test.js\"",
    "fetch:ffmpeg": "node tools/fetch-ffmpeg.mjs"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "gifenc": "^1.0.3",
    "playwright": "1.63.0",
    "sts-whisper-tiny": "^1.0.0"
  },
  "main": "desktop/main.cjs",
  "author": "Ciak Studio contributors",
  "homepage": "https://github.com/joscuola11-gif/open-source-editor-software",
  "build": {
    "appId": "app.ciakstudio.editor",
    "productName": "Ciak Studio",
    "copyright": "Copyright © 2026 Ciak Studio contributors — MIT",
    "directories": {
      "output": "release",
      "buildResources": "desktop/build"
    },
    "files": [
      "desktop/*.cjs",
      "desktop/build/icon.png",
      "dist/ciak-studio.html",
      "package.json"
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/build/icon.png",
      "signAndEditExecutable": false,
      "artifactName": "Ciak-Studio-${version}-Windows-${arch}.${ext}",
      "extraResources": [
        {
          "from": "desktop/ffmpeg/win32-x64",
          "to": "ffmpeg"
        }
      ],
      "files": [
        "desktop/*.cjs",
        "desktop/build/icon.png",
        "dist/ciak-studio.html",
        "package.json",
        "!node_modules/onnxruntime-web/**",
        "!node_modules/sharp/**",
        "!node_modules/@img/**",
        "!node_modules/onnxruntime-node/{script,src}/**",
        "!node_modules/**/*.{md,map,ts,d.ts}",
        "!node_modules/onnxruntime-node/bin/napi-v6/{linux,darwin}/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/{DirectML,dxcompiler,dxil}.dll"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ciak Studio",
      "language": "1040",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Ciak-Studio-Installer-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "desktop/build/icon.png",
      "category": "AudioVideo",
      "artifactName": "Ciak-Studio-${version}-Linux-${arch}.${ext}",
      "extraResources": [
        {
          "from": "desktop/ffmpeg/linux-x64",
          "to": "ffmpeg"
        }
      ],
      "files": [
        "desktop/*.cjs",
        "desktop/build/icon.png",
        "dist/ciak-studio.html",
        "package.json",
        "!node_modules/onnxruntime-web/**",
        "!node_modules/sharp/**",
        "!node_modules/@img/**",
        "!node_modules/onnxruntime-node/{script,src}/**",
        "!node_modules/**/*.{md,map,ts,d.ts}",
        "!node_modules/onnxruntime-node/bin/napi-v6/{win32,darwin}/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**"
      ]
    },
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "desktop/build/icon.png",
      "category": "public.app-category.video",
      "identity": null,
      "artifactName": "Ciak-Studio-${version}-macOS-${arch}.${ext}",
      "extraResources": [
        {
          "from": "desktop/ffmpeg/darwin-${arch}",
          "to": "ffmpeg"
        }
      ],
      "files": [
        "desktop/*.cjs",
        "desktop/build/icon.png",
        "dist/ciak-studio.html",
        "package.json",
        "!node_modules/onnxruntime-web/**",
        "!node_modules/sharp/**",
        "!node_modules/@img/**",
        "!node_modules/onnxruntime-node/{script,src}/**",
        "!node_modules/**/*.{md,map,ts,d.ts}",
        "!node_modules/onnxruntime-node/bin/napi-v6/{win32,linux}/**"
      ]
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  }
}
